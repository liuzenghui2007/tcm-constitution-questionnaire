  "questions": [
    { "id": "q1", "text": "您精力充沛吗？", "gender": "all" },
    { "id": "q2", "text": "您容易疲乏吗？", "gender": "all" },
    { "id": "q3", "text": "您感到闷闷不乐、情绪低沉吗？", "gender": "all" },
    {
      "id": "q4",
      "text": "您比一般人耐受不了寒冷（冬天的寒冷，夏天的冷空调、电扇等）吗？",
      "gender": "all"
    },
    { "id": "q5", "text": "您容易气短（呼吸短促，接不上气）吗？", "gender": "all" },
    { "id": "q6", "text": "您容易心慌吗？", "gender": "all" },
    { "id": "q7", "text": "您胃脘部、背部或腰膝部怕冷吗？", "gender": "all" },
    { "id": "q8", "text": "您感到怕冷、衣服比别人穿得多吗？", "gender": "all" },
    { "id": "q9", "text": "您感觉身体、脸上发热吗？", "gender": "all" },
    { "id": "q10", "text": "您皮肤或口唇干吗？", "gender": "all" },
    { "id": "q11", "text": "您面部两颧潮红或偏红吗？", "gender": "all" },
    { "id": "q12", "text": "您感到身体沉重不轻松或不爽快吗？", "gender": "all" },
    { "id": "q13", "text": "您腹部肥满松软吗？", "gender": "all" },
    { "id": "q14", "text": "您嘴里有黏黏的感觉吗？", "gender": "all" },
    { "id": "q15", "text": "您面部或鼻部有油腻感或者油亮发光吗？", "gender": "all" },
    { "id": "q16", "text": "您小便时尿道有发热感、尿色浓（深）吗？", "gender": "all" },
    {
      "id": "q17",
      "text": "您带下色黄（白带颜色发黄）吗？（限女性回答）",
