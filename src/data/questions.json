    { "id": "q18", "text": "您的阴囊部位潮湿吗？（限男性回答）", "gender": "male" },
    { "id": "q19", "text": "您身体上有哪里疼痛吗？", "gender": "all" },
    { "id": "q20", "text": "您面色晦暗或容易出现褐斑吗？", "gender": "all" },
    { "id": "q21", "text": "您口唇颜色偏暗吗？", "gender": "all" },
    { "id": "q22", "text": "您容易精神紧张、焦虑不安吗？", "gender": "all" },
    { "id": "q23", "text": "您多愁善感、感情脆弱吗？", "gender": "all" },
    { "id": "q24", "text": "您没有感冒时也会打喷嚏吗？", "gender": "all" },
    {
      "id": "q25",
      "text": "您容易过敏（对药物、食物、气味、花粉或在季节交替、气候变化时）吗？",
      "gender": "all"
    },
    {
